<view class="date-banner" wx:if="{{isBackfill}}">
  <text class="date-banner-text">正在补记 {{recordDateKey}} 的饮食记录</text>
  <text class="date-banner-exit" bindtap="onExitBackfill">切回今天</text>
</view>

<view class="search-bar">
  <input
    type="text"
    placeholder="搜索食物，如：米饭、鸡蛋"
    value="{{keyword}}"
    bindinput="onInput"
  />
</view>

<view class="food-list">
  <view
    class="food-item"
    wx:for="{{results}}"
    wx:key="id"
    data-id="{{item.id}}"
    bindtap="onSelectFood"
  >
    <view class="food-name">{{item.name}}</view>
    <view class="food-meta">{{item.calories}} kcal / 100g · {{item.category}}</view>
  </view>

  <view class="empty" wx:if="{{!hasKeyword}}">输入食物名称开始搜索，如：米饭、鸡蛋、豆腐</view>
  <view class="empty" wx:elif="{{searching && results.length === 0}}">搜索中...</view>
  <view class="empty" wx:elif="{{!searching && results.length === 0}}">没有找到「{{keyword}}」相关食物</view>
</view>

<view class="modal-mask" wx:if="{{selectedFood}}" bindtap="onCloseModal">
  <view class="modal" catchtap="noop">
    <view class="modal-title">{{selectedFood.name}}</view>
    <view class="modal-meta">{{selectedFood.calories}} kcal · 蛋白质 {{selectedFood.protein}}g · 碳水 {{selectedFood.carbs}}g · 脂肪 {{selectedFood.fat}}g · 膳食纤维 {{selectedFood.fiber}}g / 100g</view>
    <view class="modal-micro">维A {{selectedFood.vitaminA}}μg · 维C {{selectedFood.vitaminC}}mg · 钙 {{selectedFood.calcium}}mg · 镁 {{selectedFood.magnesium}}mg · 铁 {{selectedFood.iron}}mg · 锌 {{selectedFood.zinc}}mg</view>

    <view class="form-row">
      <text class="label">餐次</text>
      <picker range="{{MEAL_OPTIONS}}" value="{{mealIndex}}" bindchange="onMealChange">
        <view class="picker-value">{{MEAL_OPTIONS[mealIndex]}}</view>
      </picker>
    </view>

    <view class="form-row">
      <text class="label">分量（克）</text>
      <input type="digit" value="{{gramsInput}}" bindinput="onGramsInput" />
    </view>

    <view class="portion-tags">
      <view
        class="portion-tag {{grams === item ? 'active' : ''}}"
        wx:for="{{DEFAULT_PORTIONS}}"
        wx:key="*this"
        data-value="{{item}}"
        bindtap="onPortionTap"
      >{{item}}g</view>
    </view>

    <view class="modal-preview" wx:if="{{previewNutrients}}">
      <block wx:if="{{grams > 0 && grams <= 5000}}">
        <view class="modal-preview-title">当前 {{grams}}g 营养预览</view>
        <view class="modal-preview-values">{{previewNutrients.calories}} kcal · 蛋白质 {{previewNutrients.protein}}g · 碳水 {{previewNutrients.carbs}}g · 脂肪 {{previewNutrients.fat}}g · 膳食纤维 {{previewNutrients.fiber}}g</view>
      </block>
      <view class="modal-preview-invalid" wx:else>请输入有效克数（1~5000g）</view>
    </view>

    <button class="btn-primary" bindtap="onSave">确认记录</button>
  </view>
</view>

<view class="toast" wx:if="{{showToast}}">
  <text class="toast-text">{{toastMessage}}</text>
  <text class="toast-action" bindtap="navToToday">{{isBackfill ? '返回查看 ›' : '查看今日 ›'}}</text>
</view>
