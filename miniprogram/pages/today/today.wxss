.date-header {
  padding: 32rpx 24rpx 8rpx;
  font-size: 36rpx;
  font-weight: 600;
}

.date-nav {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.date-nav-btn {
  width: 64rpx;
  height: 64rpx;
  line-height: 64rpx;
  text-align: center;
  font-size: 44rpx;
  color: #2f855a;
  background: #ffffff;
  border-radius: 12rpx;
}

.date-nav-btn.disabled {
  color: #cbd5e0;
}

.date-nav-center {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.date-nav-text {
  font-size: 36rpx;
  font-weight: 600;
  color: #1a202c;
}

.date-nav-back {
  margin-top: 4rpx;
  font-size: 24rpx;
  font-weight: 400;
  color: #2f855a;
}

.empty {
  text-align: center;
  padding: 64rpx 32rpx;
  color: #718096;
}

.link {
  display: block;
  margin-top: 24rpx;
  color: #2f855a;
}

.calorie-card {
  text-align: center;
  padding: 48rpx 32rpx;
}

.calorie-num {
  font-size: 72rpx;
  font-weight: 700;
  color: #2f855a;
  display: inline-block;
}

.calorie-num.over {
  color: #e53e3e;
}

.calorie-target {
  display: inline-block;
  color: #a0aec0;
  margin-left: 8rpx;
}

.calorie-label {
  color: #718096;
  font-size: 24rpx;
  margin-top: 8rpx;
}

.calorie-label.over {
  color: #e53e3e;
  font-weight: 500;
}

.macro-row {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
}

.macro-name {
  width: 160rpx;
  flex-shrink: 0;
  color: #4a5568;
}

.macro-bar {
  flex: 1;
  height: 16rpx;
  background: #edf2f7;
  border-radius: 8rpx;
  overflow: hidden;
  margin: 0 16rpx;
}

.macro-fill {
  height: 100%;
  background: #2f855a;
  border-radius: 8rpx;
}

.macro-fill.over {
  background: #e53e3e;
}

.macro-value {
  font-size: 24rpx;
  color: #718096;
  width: auto;
  min-width: 160rpx;
  flex-shrink: 0;
  white-space: nowrap;
  text-align: right;
}

.macro-value.over {
  color: #e53e3e;
  font-weight: 500;
}

.section-title {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
  font-size: 32rpx;
  font-weight: 600;
}

.add-link {
  color: #2f855a;
  font-size: 28rpx;
  font-weight: 500;
}

.empty-day {
  text-align: center;
  padding: 48rpx 0;
  color: #a0aec0;
  font-size: 26rpx;
}

.record-item {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #edf2f7;
}

.record-main {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.record-name {
  font-size: 30rpx;
  font-weight: 500;
}

.record-meal {
  font-size: 24rpx;
  color: #2f855a;
  background: #f0fff4;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

.record-meta {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #718096;
}

.record-meta .delete {
  color: #e53e3e;
  padding: 4rpx 8rpx;
}

.advice-card {
  background: #f0fff4;
}

.advice-summary {
  margin-bottom: 12rpx;
  color: #2f855a;
  line-height: 1.5;
}

.advice-subtitle {
  margin-top: 20rpx;
  font-size: 26rpx;
  font-weight: 500;
  color: #4a5568;
}

.advice-tag {
  display: inline-block;
  margin: 12rpx 12rpx 0 0;
  padding: 12rpx 20rpx;
  background: #ffffff;
  border-radius: 8rpx;
  color: #2f855a;
  font-size: 26rpx;
}

.advice-habit {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #718096;
}

.micro-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.micro-item {
  width: calc(33.333% - 11rpx);
  background: #f6f7f9;
  border-radius: 12rpx;
  padding: 20rpx;
  box-sizing: border-box;
}

.micro-name {
  font-size: 24rpx;
  color: #718096;
}

.micro-value {
  margin-top: 8rpx;
  font-size: 32rpx;
  font-weight: 600;
  color: #2f855a;
}

.micro-unit {
  font-size: 20rpx;
  font-weight: 400;
  color: #a0aec0;
}

.micro-target {
  margin-top: 4rpx;
  font-size: 20rpx;
  color: #a0aec0;
}

.micro-note {
  margin-top: 16rpx;
  font-size: 22rpx;
  color: #a0aec0;
  line-height: 1.5;
}
