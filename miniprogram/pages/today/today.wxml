<view class="date-header">
  <view class="date-nav">
    <view class="date-nav-btn" bindtap="onPrevDay">‹</view>
    <view class="date-nav-center">
      <text class="date-nav-text">{{dateStr}}</text>
      <text class="date-nav-back" wx:if="{{!isToday}}" bindtap="onBackToday">回到今天</text>
    </view>
    <view class="date-nav-btn {{isToday ? 'disabled' : ''}}" bindtap="onNextDay">›</view>
  </view>
</view>

<view class="card empty" wx:if="{{!targets}}">
  <text>还没有设置营养目标</text>
  <navigator url="/pages/profile/profile" open-type="switchTab" class="link">去「我的」填写身体档案 →</navigator>
</view>

<block wx:if="{{targets}}">
  <view class="card calorie-card">
    <view class="calorie-num {{isCalorieOver ? 'over' : ''}}">{{totals.calories}}</view>
    <view class="calorie-target">/ {{targets.calories}} kcal</view>
    <view class="calorie-label over" wx:if="{{isCalorieOver}}">{{isToday ? '今日' : '当日'}}已超出 {{calorieOverAmount}} kcal</view>
    <view class="calorie-label" wx:else>{{isToday ? '今日已摄入' : '当日已摄入'}}</view>
  </view>

  <view class="card">
    <view class="macro-row" wx:for="{{macroList}}" wx:key="key">
      <text class="macro-name">{{item.name}}</text>
      <view class="macro-bar">
        <view class="macro-fill {{item.isOver ? 'over' : ''}}" style="width: {{item.pct}}%"></view>
      </view>
      <text class="macro-value {{item.isOver ? 'over' : ''}}">{{item.value}} / {{item.target}}g</text>
    </view>
  </view>

  <view class="card">
    <view class="section-title">更多营养素</view>
    <view class="micro-grid">
      <view class="micro-item" wx:for="{{microList}}" wx:key="key">
        <view class="micro-name">{{item.name}}</view>
        <view class="micro-value">{{item.value}} <text class="micro-unit">{{item.unit}}</text></view>
        <view class="micro-target">目标 {{item.target}}{{item.unit}}</view>
      </view>
    </view>
    <view class="micro-note">微量营养素为全天累计摄入，随当日记账逐步累加，无需一次性补足。</view>
  </view>

  <view class="card advice-card" wx:if="{{advice}}">
    <view class="section-title">
      <text>今日建议</text>
    </view>
    <view class="advice-summary" wx:for="{{advice.summary}}" wx:key="*this">{{item}}</view>

    <block wx:if="{{advice.recommendations && advice.recommendations.length > 0}}">
      <view class="advice-subtitle">{{advice.calorieState === 'over' ? '低卡轻食参考' : '推荐补充'}}</view>
      <view class="advice-tag" wx:for="{{advice.recommendations}}" wx:key="id" data-id="{{item.id}}" data-name="{{item.name}}" bindtap="onTapRecommend">{{item.name}}</view>
    </block>

    <view class="advice-subtitle">健康小习惯</view>
    <view class="advice-habit" wx:for="{{advice.habits}}" wx:key="*this">· {{item}}</view>
  </view>
</block>

<view class="card">
  <view class="section-title">
    <text>{{isToday ? '今日记录' : '当日记录'}}</text>
    <text class="add-link" bindtap="navToRecord">{{isToday ? '+ 记一笔' : '+ 补记一笔'}}</text>
  </view>

  <block wx:if="{{records.length === 0}}">
    <view class="empty-day">{{isToday ? '今天还没有记录食物，去记一笔吧' : '这一天还没有记录食物，去补记一笔吧'}}</view>
  </block>

  <block wx:else>
    <view class="record-item" wx:for="{{records}}" wx:key="id">
      <view class="record-main">
        <text class="record-name">{{item.foodName}}</text>
        <text class="record-meal">{{item.meal}}</text>
      </view>
      <view class="record-meta">
        <text>{{item.grams}}g · {{item.calories}} kcal</text>
        <text class="delete" data-id="{{item.id}}" bindtap="onDelete">删除</text>
      </view>
    </view>
  </block>
</view>
